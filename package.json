{
  "name": "vue-easy-data-table",
  "author": "HC200ok",
  "description": "A customizable and easy-to-use data table component made with Vue.js 3.x. Actively maintained fork of vue3-easy-data-table.",
  "private": false,
  "version": "1.6.0-alpha.3",
  "types": "./types/main.d.ts",
  "license": "MIT",
  "files": [
    "dist",
    "types"
  ],
  "keywords": [
    "vue3",
    "data-table-component",
    "data-table",
    "vue3-component",
    "vue-component"
  ],
  "homepage": "https://github.com/abvivek/vue-easy-data-table",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abvivek/vue-easy-data-table.git"
  },
  "main": "./dist/vue3-easy-data-table.umd.js",
  "module": "./dist/vue3-easy-data-table.es.js",
  "type": "module",
  "exports": {
    ".": {
      "types": "./types/main.d.ts",
      "import": {
        "types": "./types/main.d.ts",
        "default": "./dist/vue3-easy-data-table.es.js"
      },
      "require": {
        "types": "./types/main.d.ts",
        "default": "./dist/vue3-easy-data-table.umd.js"
      },
      "default": "./dist/vue3-easy-data-table.es.js"
    },
    "./dist/style.css": "./dist/style.css"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "bench": "vitest run --config vitest.bench.config.ts",
    "coverage": "vitest run --coverage"
  },
  "peerDependencies": {
    "vue": "^3.4.0 || ^3.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^22.13.0",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vitest/coverage-v8": "^3.2.4",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.39.0",
    "eslint-plugin-vue": "^9.32.0",
    "globals": "^15.14.0",
    "happy-dom": "^17.4.4",
    "sass": "^1.85.0",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.24.0",
    "vite": "^6.3.5",
    "vitest": "^3.2.4",
    "vue": "^3.5.13",
    "vue-tsc": "^2.2.4"
  }
}
